              "raw": "{{base_url}}/dashboard/stats?period=month",
              "host": ["{{base_url}}"],
              "path": ["dashboard", "stats"],
              "query": [
                {
                  "key": "period",
                  "value": "month"
                }
              ]
            }
          }
        }
      ]
